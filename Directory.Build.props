<Project>

  <!--
    Les sorties de compilation ne doivent jamais atterrir dans le dossier du dépôt :
    celui-ci est synchronisé par Google Drive, et une publication self-contained y
    pousserait plusieurs dizaines de mégaoctets à chaque build.

    Racine par défaut : C:\proton, hors du dépôt et hors des dossiers masqués par
    l'Explorateur Windows. Surchargeable par la variable d'environnement
    PROTON_OUTPUT_ROOT, pour une machine où cet emplacement ne conviendrait pas.

        C:\proton\
        ├── build\    artefacts intermédiaires — jamais à consulter
        └── dist\     Proton.exe publié
  -->
  <PropertyGroup>
    <ProtonOutputRoot Condition="'$(ProtonOutputRoot)' == ''">$(PROTON_OUTPUT_ROOT)</ProtonOutputRoot>
    <ProtonOutputRoot Condition="'$(ProtonOutputRoot)' == ''">C:\proton</ProtonOutputRoot>

    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(ProtonOutputRoot)\build</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
